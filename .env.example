# Local development. Copy to .env and keep credentials out of Git.
PORT=8787
ROSTER_HTTP_HOST=127.0.0.1
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=roster-local
ROSTER_WORKSPACE_ID=roster/default

# Set a private token to require browser/API authentication; sign in at /auth.
# ROSTER_API_TOKEN=
# Remote binding additionally requires an exact browser origin.
# ROSTER_PUBLIC_ORIGIN=https://roster.example.com

# Native model-backed examples need an API key. CLI runtimes use their own login.
# OPENAI_API_KEY=

# Optional self-managed deployment; there is no shared Roster production backend.
# ROSTER_SPACETIME_MODE=production
# ROSTER_SPACETIME_PRODUCTION_URI=https://maincloud.spacetimedb.com
# ROSTER_SPACETIME_PRODUCTION_DATABASE=your-roster-database
